# ====================================================
# EduCare Backend — Environment Variables
# Copy this file to .env and fill in REAL values.
# NEVER commit the .env file to version control.
# ====================================================

# Django
# Generate a strong SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — replace with your actual credentials
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Optional: Redis cache URL
# REDIS_URL=redis://localhost:6379/1

# CORS — Comma-separated list of trusted frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Docker Compose postgres service credentials (only used with docker-compose)
POSTGRES_DB=educare_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password
